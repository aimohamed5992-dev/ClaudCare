{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=127.0.0.1;Port=3306;Database=claudcare;User=root;Password=;CharSet=utf8mb4;"
  },
  "Database": {
    "ServerType": "MariaDb",
    "ServerVersion": "10.4.28",
    "CreateIfMissing": true,
    "MigrateOnStartup": true,
    "CommandTimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ],
    "AllowAnyLocalhost": true
  },
  "Jwt": {
    "Issuer": "claudcare-api",
    "Audience": "claudcare-app",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30,
    "ChallengeMinutes": 10
  },
  "Auth": {
    "OtpLength": 6,
    "OtpMinutes": 5,
    "OtpMaxAttempts": 5,
    "OtpResendSeconds": 30,
    "OtpMaxPerHour": 6,
    "RequireOtpForStaff": true,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "MaxActiveSessions": 10,
    "MinPasswordLength": 8
  },
  "RateLimit": {
    "AuthPermitPerMinute": 30
  },
  "Seed": {
    "DemoAccounts": false,
    "DemoPassword": "Demo@1234"
  },
  "Clinic": {
    "TimeZone": "Asia/Riyadh",
    "FallbackUtcOffsetHours": 3
  },
  "Booking": {
    "MinLeadMinutes": 0,
    "MaxAdvanceDays": 60,
    "DefaultAvailabilityDays": 14,
    "FreeCancellationHours": 24,
    "LateCancellationFeePercent": 50
  }
}